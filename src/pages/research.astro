---
import Base from '../layouts/Base.astro';
import { research, site } from '../lib/data';

const description = `${site.name}'s research on hyperproperties, quantitative verification, and runtime monitoring for reliable and responsible computing.`;
---

<Base title="Research" description={description} contentStyles>
  <header class="research-intro">
    <h1 class="label">Research</h1>
    <p>{research.intro}</p>
  </header>

  <section class="research-areas" aria-label="Research areas">
    {research.areas.map((area, index) => (
      <article class="research-area">
        <div>
          <h2 class="entry-title">{area.title}</h2>
          <p class="research-definition">{area.definition}</p>
          <p class="research-contribution">{area.contribution}</p>
        </div>
        <figure class="research-art" aria-hidden="true">
          <img
            src={area.image}
            alt=""
            width="900"
            height="600"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </figure>
      </article>
    ))}
  </section>

  <section class="research-project" aria-labelledby="qhyperstar-title">
    <div class="research-project-body">
      <div>
        <h2 id="qhyperstar-title" class="entry-title">{research.project.title}</h2>
        <p class="research-project-name">{research.project.full_title}</p>
      </div>
      <p class="research-project-meta">
        {research.project.programme}<br />
        {research.project.dates}
      </p>
      <p class="research-project-description">{research.project.description}</p>
      <a class="research-project-link" href={research.project.record}>
        CORDIS project record <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>

<style>
  :global(main.site-content:has(> .research-intro)) {
    line-height: 1.52;
  }

  .research-intro {
    max-width: 41.5rem;
    margin-bottom: 0;
  }

  .research-intro + .research-areas,
  .research-areas + .research-project {
    margin-top: var(--space-group);
  }

  .research-intro p {
    margin: 0;
    font-style: italic;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .research-area {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13.25rem;
    align-items: center;
    gap: 2.5rem;
    padding-block: 0;
  }

  .research-area + .research-area {
    margin-top: var(--space-entry);
  }

  .research-area h2,
  .research-project h2 {
    margin: 0;
    text-wrap: pretty;
  }

  .research-area p {
    text-wrap: pretty;
  }

  .research-definition {
    margin: var(--space-title) 0 0;
  }

  .research-contribution {
    margin: var(--space-paragraph) 0 0;
    color: var(--ink-soft);
  }

  .research-art {
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper);
    background: color-mix(in srgb, var(--accent) 4%, var(--paper));
  }

  .research-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .research-project {
    margin-bottom: 0;
    border-left: 3px solid var(--accent);
    background: var(--paper);
    background: color-mix(in srgb, var(--accent) 5%, var(--paper));
  }

  .research-project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    gap: var(--space-paragraph) 2rem;
    padding: var(--space-paragraph) 1.25rem;
  }

  .research-project-name {
    margin: var(--space-title) 0 0;
    max-width: 30rem;
    color: var(--ink-soft);
    font-style: italic;
    line-height: 1.38;
  }

  .research-project-meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.55;
    color: var(--ink-soft);
    text-align: right;
  }

  .research-project-description {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 39rem;
    text-wrap: pretty;
  }

  .research-project-link {
    grid-column: 1 / -1;
    justify-self: start;
    margin: 0;
    font-family: var(--sans);
    font-size: var(--type-mono);
    font-weight: 600;
  }

  :global(:root[data-theme='dark']) .research-art img {
    filter: brightness(0.82) saturate(0.82);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .research-art img {
      filter: brightness(0.82) saturate(0.82);
    }
  }

  @media (max-width: 43rem) {
    .research-area {
      grid-template-columns: 1fr;
      row-gap: var(--space-paragraph);
    }

    .research-art {
      width: min(18rem, 100%);
    }

    .research-project-body {
      grid-template-columns: 1fr;
    }

    .research-project-meta,
    .research-project-description,
    .research-project-link {
      grid-column: 1;
    }

    .research-project-meta {
      text-align: left;
    }
  }

  @media print {
    .research-art {
      display: none;
    }

    .research-area {
      display: block;
    }

    .research-project {
      background: none;
    }
  }
</style>
